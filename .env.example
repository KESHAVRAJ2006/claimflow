# Copy this file to .env and adjust. docker-compose reads it automatically,
# and the backend reads it when you run it directly on your machine.

# --- Postgres container ---
# Keep the password URL-safe (letters, digits, _ -) because it is embedded in DATABASE_URL.
POSTGRES_USER=claimflow
POSTGRES_PASSWORD=claimflow_dev_password
POSTGRES_DB=claimflow

# --- Host ports (change these if something else on your machine already uses them) ---
POSTGRES_PORT=5432
QDRANT_PORT=6333
BACKEND_PORT=8000

# --- Backend settings ---
# Inside Docker, docker-compose overrides DATABASE_URL and QDRANT_URL to use service hostnames.
# These localhost values are for running uvicorn directly on your machine.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://claimflow:claimflow_dev_password@localhost:5432/claimflow
QDRANT_URL=http://localhost:6333
HEALTH_CHECK_TIMEOUT_S=2.0

# --- Read-only login for the agent tools (created by scripts.provision_readonly_role on startup) ---
# Must differ from POSTGRES_USER. Password: 12-128 characters of letters, digits and _ - + / =.
AGENT_DB_USER=claimflow_agent
AGENT_DB_PASSWORD=claimflow_agent_dev_password
# TOOLS_DATABASE_URL is derived from DATABASE_URL and the two values above; set it only to use a different host.

# --- LLM providers (Phase 6). Groq is primary; Gemini is the fallback when Groq errors or rate-limits. ---
# Get keys at https://console.groq.com/keys and https://aistudio.google.com/apikey. One is enough to run.
GROQ_API_KEY=
GOOGLE_API_KEY=
# Optional model overrides (defaults: openai/gpt-oss-120b on Groq, gemini-2.5-flash).
# GROQ_MODEL=
# GEMINI_MODEL=

# --- API (Phase 7) ---
# Every endpoint except /api/health requires the header X-API-Key. Production needs 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=dev-local-api-key-change-me
# --- Notifications (Phase 11): `docker compose --profile notifications up -d` starts n8n. ---
# Events are signed with WEBHOOK_SECRET (header X-ClaimFlow-Signature); n8n rejects them without it (16+ chars).
# With the n8n profile running: N8N_WEBHOOK_URL=http://n8n:5678/webhook/claimflow
N8N_WEBHOOK_URL=
WEBHOOK_SECRET=
# Where n8n posts messages: a Slack incoming-webhook URL (Discord: <webhook URL>/slack). Blank: see Executions in n8n.
NOTIFY_WEBHOOK_URL=
# Uncomment so a plain `docker compose up -d` starts n8n as well.
# COMPOSE_PROFILES=notifications

# --- MCP server (Phase 10) ---
# Only for `python -m scripts.run_mcp --transport http`; stdio (Claude Desktop) needs no token.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
