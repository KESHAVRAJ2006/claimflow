# Server-side only (no NEXT_PUBLIC_ prefix): the browser never sees these.
# FastAPI base URL, reached by the Next.js server's /api proxy.
BACKEND_URL=http://localhost:8000
# Must match API_KEY in the repo-root .env. The proxy adds it as X-API-Key; it never reaches the browser.
API_KEY=dev-local-api-key-change-me
